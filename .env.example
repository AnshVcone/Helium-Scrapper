# Helium 10 credentials for the scraper's automated sign-in.
# Copy to .env and fill in. .env is gitignored -- never commit it.
# Do NOT put real values in this file: this template IS tracked.
#
# Use a seat WITHOUT 2FA: two-factor cannot be automated.
H10_EMAIL=
H10_PASSWORD=

# Postgres. Point at STAGING. Same DB and table prefix the Go helium sync uses,
# so both write into the same two tables.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
DB_TABLE_PREFIX=dev_az_
DB_POOL_MAX=5

# HTTP service
PORT=8090
