# Helium 10 credentials for the scraper's automated sign-in.
# Copy to .env and fill in. .env is gitignored -- never commit it.
# Do NOT put real values in this file: this template IS tracked.
#
# Use a seat WITHOUT 2FA: two-factor cannot be automated.
H10_EMAIL=
H10_PASSWORD=

# Which database a run writes to: dev or staging.
#
# DEFAULT IS dev, deliberately. An unconfigured box must not write to the shared
# staging tables because someone forgot a variable -- the safe direction for a
# missing value is the throwaway database.
SCRAPER_MODE=dev

# The dev target. Used when SCRAPER_MODE=dev.
#
# Dev mode will NOT fall back to the unprefixed DB_* variables below: those point
# at staging, so falling back would write a "dev test run" straight into the
# shared tables. A missing DEV_DB_* is an error in dev mode, not a default.
#
# The two research tables may not exist in a fresh dev database. Create them
# from staging's shape with:  node scripts/init-dev-tables.mjs --apply
DEV_DB_HOST=
DEV_DB_PORT=5432
DEV_DB_NAME=
DEV_DB_USER=
DEV_DB_PASS=
DEV_DB_TABLE_PREFIX=dev_az_

# The staging target. Used when SCRAPER_MODE=staging. Same DB and table prefix
# the Go helium sync uses, so both write into the same two tables.
STAGING_DB_HOST=
STAGING_DB_PORT=5432
STAGING_DB_NAME=
STAGING_DB_USER=
STAGING_DB_PASS=
STAGING_DB_TABLE_PREFIX=dev_az_

# Legacy unprefixed variables. Still honoured, but ONLY in staging mode, so an
# older .env keeps working. Prefer the STAGING_DB_* names above.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
DB_TABLE_PREFIX=dev_az_
DB_POOL_MAX=5

# Borrowing a signed-in session instead of solving the CAPTCHA.
#
# Helium 10 serves a reCAPTCHA on automated sign-in and solving it is out of
# scope. The way round it is to let a human sign in normally and lend the
# scraper the resulting session.
#
# Preferred: export the helium10.com cookies from a signed-in browser as a JSON
# array (DevTools -> Application, or a cookie-export extension), save as
# cookies.json, and point this at it. A LIVE SESSION IS A CREDENTIAL -- the file
# is gitignored; keep it that way.
H10_COOKIES_FILE=

# Fallback: just the _identity cookie value. Note this alone was REJECTED by the
# server in testing -- it clears the cookie rather than ignoring it, apparently
# because an auth cookie with no matching session looks like a replayed token.
# Use H10_COOKIES_FILE instead.
H10_IDENTITY_COOKIE=

# Headless is the DEFAULT. Set HEADLESS=0 only on a machine with a display; a
# server has no X server, so a headed launch there fails immediately.
# (`npm run login` opens a window regardless when it needs one.)
HEADLESS=1

# On-page behaviour: scrolls, cursor movement, dwell, during the gap between
# ASINs that was already being spent. Costs no extra time and no extra requests.
# HUMANIZE=0 disables it.
HUMANIZE=1

# Occasional longer pauses, so the gap distribution is not regular for hours.
# Costs ~3 min per 60 ASINs (~15% slower) and lets a squeezed IP recover.
# LONG_BREAK_EVERY_MIN=0 disables.
LONG_BREAK_EVERY_MIN=45
LONG_BREAK_EVERY_MAX=90
LONG_BREAK_MS_MIN=90000
LONG_BREAK_MS_MAX=300000

# HTTP service
PORT=8090

# Which interface to bind. DEFAULT IS LOOPBACK ONLY (127.0.0.1).
#
# There is no authentication on this service and every useful endpoint writes:
# POST /jobs starts a job that writes to a shared database. On a VM with a public
# address and no firewall rule, binding 0.0.0.0 exposes that to anyone scanning
# the IP. SSH credentials gate a shell, not an open TCP port.
#
# Leave this alone and reach the UI through a tunnel instead:
#   ssh -L 8090:localhost:8090 <user>@<vm>
#
# Set to 0.0.0.0 ONLY behind a firewall that restricts this port.
BIND_HOST=127.0.0.1

# Zoho Cliq incoming webhook for alerts: throttling, bot walls, a changed panel,
# a lost H10 session, every finished job, and an idle box with backlog left.
# Get it from Cliq: channel -> Integrations -> Incoming Webhook. The URL carries
# a zapikey, so it is a credential -- it belongs here in .env only, never in a
# commit or a chat message.
#
# Leave blank to disable alerting entirely; the scraper runs unchanged and just
# logs that alerts are off.
CLIQ_WEBHOOK_URL=

# Shown in every alert so a message identifies its box. Defaults to the
# hostname; set it to something readable like "gce-scraper-a (34.x.x.x)" once
# there is more than one server, since the IP is the thing you rotate.
SCRAPER_HOST_LABEL=

# Alerting thresholds.
# Consecutive panel timeouts before a *warning* is sent. The run continues; the
# hard stop is MAX_CONSECUTIVE_TIMEOUTS (default 6).
THROTTLE_WARN_AT=3
# Hours with no job running, nothing queued, and backlog still outstanding
# before the idle alarm fires -- the only alert that can catch a box that
# stopped working while staying healthy.
IDLE_ALERT_HOURS=3
# How often that idle alarm repeats while the condition persists.
IDLE_REPEAT_HOURS=6
